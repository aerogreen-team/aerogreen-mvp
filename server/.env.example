# ============================================================
# VƯỜN PHỐ — Biến môi trường (copy thành `.env`)
# Lưu ý: KHÔNG commit file `.env` thật (đã có trong .gitignore)
# ============================================================

# ------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU
# ------------------------------------------------------------
# Chạy local: ĐỂ TRỐNG cả 2 biến dưới — hệ thống tự dùng file
# `server/aerogreen.db` (libSQL hỗ trợ "file:"), không cần cấu hình gì.

# Production (Turso): lấy bằng lệnh
#   turso db show <ten-db> --url          → TURSO_DATABASE_URL
#   turso db tokens create <ten-db>       → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Chỉ dùng khi tự host kèm volume (thay cho TURSO_*), ví dụ Railway/Render:
# DB_PATH=/data/aerogreen.db

# ------------------------------------------------------------
# 2. BẢO MẬT — BẮT BUỘC đổi trước khi deploy thật
# ------------------------------------------------------------
# Sinh chuỗi ngẫu nhiên, ví dụ:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Tài khoản quản trị mặc định do hệ thống tự tạo ở lần chạy đầu:
#   admin / admin123   → hãy đổi mật khẩu ngay sau khi deploy

# ------------------------------------------------------------
# 3. KHÁC
# ------------------------------------------------------------
# Cổng server local (mặc định 3000). Vercel/Render/Railway tự set biến này.
# PORT=3000
